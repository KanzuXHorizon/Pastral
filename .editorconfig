root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,ixx}]
indent_style = space
indent_size = 4

[*.{json,jsonc,yaml,yml}]
indent_style = space
indent_size = 2

[*.{xml,xaml,props,targets,vcxproj,filters,manifest}]
indent_style = space
indent_size = 2

[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
