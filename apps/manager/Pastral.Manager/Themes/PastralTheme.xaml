<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PastralAuroraVioletColor">#725CFF</Color>
    <Color x:Key="PastralSignalCyanColor">#2ED3FF</Color>

    <SolidColorBrush
        x:Key="PastralBrandPrimaryBrush"
        Color="{StaticResource PastralAuroraVioletColor}" />
    <SolidColorBrush
        x:Key="PastralBrandSecondaryBrush"
        Color="{StaticResource PastralSignalCyanColor}" />

    <x:Double x:Key="PastralSectionSpacing">24</x:Double>
    <x:Double x:Key="PastralContentMaxWidth">1120</x:Double>
    <CornerRadius x:Key="PastralCompactCornerRadius">12</CornerRadius>

    <Style
        x:Key="PastralCardStyle"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PastralCompactCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style
        x:Key="PastralPageHeaderStyle"
        BasedOn="{StaticResource TitleTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="PastralMetadataTextStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
