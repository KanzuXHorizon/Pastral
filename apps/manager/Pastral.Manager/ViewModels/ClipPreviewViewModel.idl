        String Id{ get; };
        String SafePreview{ get; };
        String Source{ get; };
        String RelativeTime{ get; };
        String TypeLabel{ get; };
        String Profile{ get; };
        String RepresentationSummary{ get; };
        String AutomationName{ get; };
        String StateSummary{ get; };
        Boolean Pinned{ get; };
        Boolean Unavailable{ get; };
    }
}
