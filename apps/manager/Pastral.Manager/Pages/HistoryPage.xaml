<Page
    x:Class="Pastral.Manager.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    NavigationCacheMode="Enabled"
    SizeChanged="Page_SizeChanged"
    Unloaded="Page_Unloaded">

    <Grid
        x:Name="HistoryLayoutRoot"
        MaxWidth="{StaticResource PastralContentMaxWidth}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        x:Uid="HistoryPageContent"
        AutomationProperties.Name="History page content"
        Padding="28,24,28,24"
        RowSpacing="18">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="HistoryLayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HistoryLayoutRoot.Padding" Value="20,16,20,28" />
                            <Setter Target="HistoryColumns.ColumnDefinitions[0].Width" Value="*" />
                            <Setter Target="HistoryColumns.ColumnDefinitions[1].Width" Value="0" />
                            <Setter Target="HistoryResultsRegion.(Grid.Column)" Value="0" />
                            <Setter Target="HistoryResultsRegion.(Grid.Row)" Value="0" />
                            <Setter Target="HistoryDetailsRegion.(Grid.Column)" Value="0" />
                            <Setter Target="HistoryDetailsRegion.(Grid.Row)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="920" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HistoryLayoutRoot.Padding" Value="28,24,28,36" />
                            <Setter Target="HistoryColumns.ColumnDefinitions[0].Width" Value="3*" />
                            <Setter Target="HistoryColumns.ColumnDefinitions[1].Width" Value="2*" />
                            <Setter Target="HistoryResultsRegion.(Grid.Column)" Value="0" />
                            <Setter Target="HistoryResultsRegion.(Grid.Row)" Value="0" />
                            <Setter Target="HistoryDetailsRegion.(Grid.Column)" Value="1" />
                            <Setter Target="HistoryDetailsRegion.(Grid.Row)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="HistoryHeaderStates">
                    <VisualState x:Name="NarrowHistoryHeader">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HistoryHeader.ColumnDefinitions[1].Width" Value="0" />
                            <Setter Target="HistoryResultCount.(Grid.Row)" Value="1" />
                            <Setter Target="HistoryResultCount.(Grid.Column)" Value="0" />
                            <Setter Target="HistoryResultCount.HorizontalAlignment" Value="Left" />
                            <Setter Target="HistoryResultCount.Margin" Value="0,4,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideHistoryHeader">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HistoryHeader.ColumnDefinitions[1].Width" Value="Auto" />
                            <Setter Target="HistoryResultCount.(Grid.Row)" Value="0" />
                            <Setter Target="HistoryResultCount.(Grid.Column)" Value="1" />
                            <Setter Target="HistoryResultCount.HorizontalAlignment" Value="Right" />
                            <Setter Target="HistoryResultCount.Margin" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="HistoryHeader"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="7">
                    <TextBlock
                        x:Uid="HistoryPageEyebrow"
                        Foreground="{StaticResource PastralBrandPrimaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Search with context" />
                    <TextBlock
                        x:Uid="HistoryPageTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource PastralPageHeaderStyle}"
                        Text="Find anything you copied" />
                    <TextBlock
                        x:Uid="HistoryPageSubtitle"
                        MaxWidth="720"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Search privacy-safe previews by content, source, type, profile, or representation." />
                </StackPanel>
                <TextBlock
                    x:Name="HistoryResultCount"
                    Grid.Column="1"
                    AutomationProperties.LiveSetting="Polite"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource PastralMetadataTextStyle}"
                    Text="0 items" />
            </Grid>

            <StackPanel
                Grid.Row="1"
                Spacing="12">
                <InfoBar
                    x:Name="HistoryConnectionStatus"
                    x:Uid="HistoryConnectionStatus"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="History availability status"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />
                <InfoBar
                    x:Name="HistorySyntheticNotice"
                    x:Uid="HistorySyntheticNotice"
                    AutomationProperties.Name="Synthetic history disclosure"
                    IsClosable="False"
                    IsOpen="True"
                    Message="These bounded examples exist only in Debug builds and are not clipboard history."
                    Severity="Informational"
                    Title="Synthetic preview data"
                    Visibility="Collapsed" />
            </StackPanel>

            <Grid
                x:Name="HistoryCommandBar"
                Grid.Row="2"
                ColumnSpacing="12">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="HistoryCommandLayoutStates">
                        <VisualState x:Name="NarrowCommandLayout" />
                        <VisualState x:Name="WideCommandLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="640" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HistoryCommandBar.RowDefinitions[1].Height" Value="0" />
                                <Setter Target="HistorySearchBox.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="HistoryClearButton.(Grid.Row)" Value="0" />
                                <Setter Target="HistoryClearButton.(Grid.Column)" Value="1" />
                                <Setter Target="HistoryClearButton.Margin" Value="0" />
                                <Setter Target="HistoryRetryButton.(Grid.Row)" Value="0" />
                                <Setter Target="HistoryRetryButton.(Grid.Column)" Value="2" />
                                <Setter Target="HistoryRetryButton.Margin" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <AutoSuggestBox
                    x:Name="HistorySearchBox"
                    Grid.ColumnSpan="3"
                    AutomationProperties.HelpText="Searches only privacy-safe preview metadata supplied by the active provider"
                    AutomationProperties.Name="Search clipboard history"
                    x:Uid="HistorySearchBox"
                    MinHeight="44"
                    PlaceholderText="Search content, apps, types, or profiles"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />
                <Button
                    x:Name="HistoryClearButton"
                    x:Uid="HistoryClearButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,12,0,0"
                    AutomationProperties.Name="Clear history search"
                    Click="ClearFilters_Click"
                    Content="Clear"
                    IsEnabled="False"
                    VerticalAlignment="Bottom" />
                <Button
                    x:Name="HistoryRetryButton"
                    x:Uid="HistoryRetryButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,12,0,0"
                    AutomationProperties.Name="Retry local agent connection"
                    Click="Retry_Click"
                    Content="Retry"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed" />
            </Grid>

            <Grid
                x:Name="HistoryColumns"
                Grid.Row="3"
                ColumnSpacing="16"
                RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="HistoryResultsRegion"
                    x:Uid="HistoryResultsRegion"
                    AutomationProperties.Name="History results"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource PastralHeroPanelStyle}">
                    <Grid>
                        <ListView
                            x:Name="HistoryResultsList"
                            x:Uid="HistoryResultsList"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="History results list"
                            SelectionChanged="ResultsList_SelectionChanged"
                            SelectionMode="Single"
                            Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        Padding="12,10"
                                        ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                MaxLines="3"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{Binding SafePreview}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                MaxLines="1"
                                                Style="{StaticResource PastralMetadataTextStyle}"
                                                Text="{Binding Source}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Spacing="3">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{Binding TypeLabel}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource PastralMetadataTextStyle}"
                                                Text="{Binding RelativeTime}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource PastralMetadataTextStyle}"
                                                Text="{Binding Profile}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                MaxWidth="220"
                                                Style="{StaticResource PastralMetadataTextStyle}"
                                                Text="{Binding RepresentationSummary}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource PastralMetadataTextStyle}"
                                                Text="{Binding StateSummary}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="HistoryNoResultsPanel"
                            x:Uid="HistoryNoResultsPanel"
                            MaxWidth="440"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="History empty or no-results state"
                            Spacing="12">
                            <ProgressRing
                                x:Name="HistoryLoadingIndicator"
                                x:Uid="HistoryLoadingIndicator"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Connecting to local agent"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="HistoryEmptyIcon"
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="14">
                                <FontIcon
                                    x:Uid="HistoryEmptyIconGlyph"
                                    AutomationProperties.Name="Clipboard history"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Glyph="&#xE81C;" />
                            </Border>
                            <TextBlock
                                x:Name="HistoryNoResultsTitle"
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                x:Uid="HistoryNoResultsTitle"
                                Text="Your clipboard memory is empty" />
                            <TextBlock
                                x:Name="HistoryNoResultsDetail"
                                TextAlignment="Center"
                                Style="{StaticResource PastralMetadataTextStyle}"
                                x:Uid="HistoryNoResultsDetail"
                                Text="Start the local agent to capture privacy-safe history. Pastral never invents or reads data outside the verified provider." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="HistoryDetailsRegion"
                    x:Uid="HistoryDetailsRegion"
                    Grid.Column="1"
                    AutomationProperties.Name="Selected clip details"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource PastralCardStyle}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Button
                                x:Name="HistoryBackButton"
                                x:Uid="HistoryBackButton"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Back to history results"
                                Click="BackToResults_Click"
                                Content="Back to results"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="Collapsed" />
                            <StackPanel Spacing="4">
                            <TextBlock
                                x:Uid="HistoryDetailsTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource PastralSectionHeaderStyle}"
                                Text="Clip details" />
                            <TextBlock
                                x:Name="HistoryDetailPreview"
                                MaxLines="4"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                x:Uid="HistoryDetailPreview"
                                Text="Select a clip to inspect its source and available representations"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            IsHitTestVisible="False" />
                        <Grid
                            ColumnSpacing="12"
                            RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="HistoryFieldSource" Style="{StaticResource PastralMetadataTextStyle}" Text="Source" />
                            <TextBlock
                                x:Name="HistoryDetailSource"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Unavailable"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Uid="HistoryFieldType"
                                Grid.Row="1"
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Type" />
                            <TextBlock
                                x:Name="HistoryDetailType"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Unavailable" />
                            <TextBlock
                                x:Uid="HistoryFieldRepresentations"
                                Grid.Row="2"
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Representations" />
                            <TextBlock
                                x:Name="HistoryDetailRepresentation"
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Unavailable"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Uid="HistoryFieldProfile"
                                Grid.Row="3"
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Profile" />
                            <TextBlock
                                x:Name="HistoryDetailProfile"
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Unavailable" />
                            <TextBlock
                                x:Uid="HistoryFieldState"
                                Grid.Row="4"
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="State" />
                            <TextBlock
                                x:Name="HistoryDetailState"
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Unavailable"
                                TextWrapping="Wrap" />
                        </Grid>
                        <InfoBar
                            x:Name="HistoryAvailabilityWarning"
                            x:Uid="HistoryAvailabilityWarning"
                            AutomationProperties.Name="Selected clip availability warning"
                            IsClosable="False"
                            IsOpen="True"
                            Message="The referenced content is unavailable, so paste and copy remain disabled."
                            Severity="Warning"
                            Title="Content unavailable"
                            Visibility="Collapsed" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="HistoryPasteButton"
                                x:Uid="HistoryPasteButton"
                                AutomationProperties.HelpText="Paste is disabled until versioned history IPC and destination validation are implemented"
                                AutomationProperties.Name="Paste selected representation"
                                Content="Paste"
                                IsEnabled="False" />
                            <Button
                                x:Name="HistoryCopyButton"
                                x:Uid="HistoryCopyButton"
                                AutomationProperties.HelpText="Copy is disabled until versioned history IPC is implemented"
                                AutomationProperties.Name="Copy selected representation"
                                Content="Copy"
                                IsEnabled="False" />
                        </StackPanel>
                            <TextBlock
                                x:Uid="HistoryActionsNote"
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Actions remain unavailable in this build; the manager never bypasses the authenticated agent boundary." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
</Page>
