<Page
    x:Class="Pastral.Manager.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid
        x:Name="HistoryLayoutRoot"
        MaxWidth="{StaticResource PastralContentMaxWidth}"
        Padding="24,20,24,32"
        RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HistoryLayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.Setters>
                        <Setter Target="HistoryColumns.ColumnDefinitions[0].Width" Value="*" />
                        <Setter Target="HistoryColumns.ColumnDefinitions[1].Width" Value="0" />
                        <Setter Target="HistoryResultsRegion.(Grid.Column)" Value="0" />
                        <Setter Target="HistoryResultsRegion.(Grid.Row)" Value="0" />
                        <Setter Target="HistoryDetailsRegion.(Grid.Column)" Value="0" />
                        <Setter Target="HistoryDetailsRegion.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="920" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HistoryColumns.ColumnDefinitions[0].Width" Value="3*" />
                        <Setter Target="HistoryColumns.ColumnDefinitions[1].Width" Value="2*" />
                        <Setter Target="HistoryResultsRegion.(Grid.Column)" Value="0" />
                        <Setter Target="HistoryResultsRegion.(Grid.Row)" Value="0" />
                        <Setter Target="HistoryDetailsRegion.(Grid.Column)" Value="1" />
                        <Setter Target="HistoryDetailsRegion.(Grid.Row)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock
                    x:Uid="HistoryPageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PastralPageHeaderStyle}"
                    Text="History" />
                <TextBlock
                    x:Uid="HistoryPageSubtitle"
                    MaxWidth="720"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Find copied content by preview, source, type, profile, and time." />
            </StackPanel>
            <TextBlock
                x:Name="HistoryResultCount"
                Grid.Column="1"
                AutomationProperties.LiveSetting="Polite"
                VerticalAlignment="Bottom"
                Style="{StaticResource PastralMetadataTextStyle}"
                Text="0 items" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Spacing="12">
            <InfoBar
                x:Name="HistoryConnectionStatus"
                AutomationProperties.Name="History availability status"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />
            <InfoBar
                x:Name="HistorySyntheticNotice"
                AutomationProperties.Name="Synthetic history disclosure"
                IsClosable="False"
                IsOpen="True"
                Message="These bounded examples exist only in Debug builds and are not clipboard history."
                Severity="Informational"
                Title="Synthetic preview data"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid
            Grid.Row="2"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="HistorySearchBox"
                AutomationProperties.HelpText="Searches only privacy-safe preview metadata supplied by the active provider"
                AutomationProperties.Name="Search clipboard history"
                PlaceholderText="Search safe previews, source, type, or profile"
                TextChanged="SearchBox_TextChanged" />
            <Button
                x:Name="HistoryClearButton"
                Grid.Column="1"
                AutomationProperties.Name="Clear history search"
                Click="ClearFilters_Click"
                Content="Clear"
                IsEnabled="False"
                VerticalAlignment="Bottom" />
            <Button
                x:Name="HistoryRetryButton"
                Grid.Column="2"
                AutomationProperties.Name="Retry local agent connection"
                Click="Retry_Click"
                Content="Retry"
                VerticalAlignment="Bottom" />
        </Grid>

        <Grid
            x:Name="HistoryColumns"
            Grid.Row="3"
            ColumnSpacing="16"
            RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="HistoryResultsRegion"
                AutomationProperties.Name="History results"
                Style="{StaticResource PastralCardStyle}">
                <Grid MinHeight="420">
                    <ListView
                        x:Name="HistoryResultsList"
                        AutomationProperties.Name="History results list"
                        SelectionChanged="ResultsList_SelectionChanged"
                        SelectionMode="Single"
                        Visibility="Collapsed">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    Padding="12,10"
                                    ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            MaxLines="3"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{Binding SafePreview}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBlock
                                                Style="{StaticResource PastralMetadataTextStyle}"
                                                Text="{Binding Source}" />
                                            <TextBlock
                                                Style="{StaticResource PastralMetadataTextStyle}"
                                                Text="·" />
                                            <TextBlock
                                                Style="{StaticResource PastralMetadataTextStyle}"
                                                Text="{Binding RelativeTime}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Spacing="3">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{Binding TypeLabel}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource PastralMetadataTextStyle}"
                                            Text="{Binding RepresentationSummary}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource PastralMetadataTextStyle}"
                                            Text="{Binding Profile}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource PastralMetadataTextStyle}"
                                            Text="{Binding StateSummary}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="HistoryNoResultsPanel"
                        MaxWidth="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="History empty or no-results state"
                        Spacing="12">
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="14">
                            <FontIcon
                                AutomationProperties.Name="Clipboard history"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Glyph="&#xE81C;" />
                        </Border>
                        <TextBlock
                            x:Name="HistoryNoResultsTitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="No history is available" />
                        <TextBlock
                            x:Name="HistoryNoResultsDetail"
                            TextAlignment="Center"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="The manager intentionally remains empty instead of opening storage directly or inventing Release data." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                x:Name="HistoryDetailsRegion"
                Grid.Column="1"
                AutomationProperties.Name="Selected clip details"
                Style="{StaticResource PastralCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Clip details" />
                        <TextBlock
                            x:Name="HistoryDetailPreview"
                            MaxLines="4"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Select a history item"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        IsHitTestVisible="False" />
                    <Grid
                        ColumnSpacing="12"
                        RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PastralMetadataTextStyle}" Text="Source" />
                        <TextBlock
                            x:Name="HistoryDetailSource"
                            Grid.Column="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Unavailable"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Type" />
                        <TextBlock
                            x:Name="HistoryDetailType"
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Unavailable" />
                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Representations" />
                        <TextBlock
                            x:Name="HistoryDetailRepresentation"
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Unavailable"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Profile" />
                        <TextBlock
                            x:Name="HistoryDetailProfile"
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Unavailable" />
                        <TextBlock
                            Grid.Row="4"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="State" />
                        <TextBlock
                            x:Name="HistoryDetailState"
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Unavailable"
                            TextWrapping="Wrap" />
                    </Grid>
                    <InfoBar
                        x:Name="HistoryAvailabilityWarning"
                        AutomationProperties.Name="Selected clip availability warning"
                        IsClosable="False"
                        IsOpen="True"
                        Message="The referenced content is unavailable, so paste and copy remain disabled."
                        Severity="Warning"
                        Title="Content unavailable"
                        Visibility="Collapsed" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="HistoryPasteButton"
                            AutomationProperties.HelpText="Paste is disabled until versioned local IPC and destination validation are implemented"
                            AutomationProperties.Name="Paste selected representation"
                            Content="Paste"
                            IsEnabled="False" />
                        <Button
                            x:Name="HistoryCopyButton"
                            AutomationProperties.HelpText="Copy is disabled until versioned local IPC is implemented"
                            AutomationProperties.Name="Copy selected representation"
                            Content="Copy"
                            IsEnabled="False" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource PastralMetadataTextStyle}"
                        Text="Actions remain unavailable in this UI foundation; the manager never bypasses the agent boundary." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
