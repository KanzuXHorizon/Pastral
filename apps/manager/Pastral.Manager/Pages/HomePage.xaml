<Page
    x:Class="Pastral.Manager.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer
        AutomationProperties.Name="Home page content"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="{StaticResource PastralContentMaxWidth}"
            Padding="28,24,28,36"
            RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PastralHeroPanelStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock
                            x:Uid="HomePageEyebrow"
                            Foreground="{StaticResource PastralBrandPrimaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="LOCAL • PRIVATE • READY" />
                        <TextBlock
                            x:Uid="HomePageTitle"
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource PastralPageHeaderStyle}"
                            Text="Your clipboard, remembered" />
                        <TextBlock
                            x:Uid="HomePageSubtitle"
                            MaxWidth="720"
                            HorizontalAlignment="Left"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Check capture health and return to recent clipboard activity without leaving your local session." />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Width="48"
                        Height="48"
                        VerticalAlignment="Center"
                        Style="{StaticResource PastralBrandMarkStyle}">
                        <FontIcon
                            AutomationProperties.Name="Clipboard memory"
                            FontSize="22"
                            Foreground="White"
                            Glyph="&#xE81C;" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel
                Grid.Row="1"
                Spacing="12">
                <InfoBar
                    x:Name="HomeConnectionStatus"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Manager connection status"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />
                <InfoBar
                    x:Name="HomeSyntheticNotice"
                    AutomationProperties.Name="Synthetic preview disclosure"
                    IsClosable="False"
                    IsOpen="True"
                    Message="These six bounded examples exist only in Debug builds and are not clipboard history."
                    Severity="Informational"
                    Title="Synthetic preview data"
                    Visibility="Collapsed" />
            </StackPanel>

            <Border
                x:Name="HomeOperationalStateRegion"
                Grid.Row="2"
                AutomationProperties.Name="Operational state"
                Style="{StaticResource PastralCardStyle}">
                <Grid
                    ColumnSpacing="16"
                    RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing
                        x:Name="HomeLoadingIndicator"
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Connecting to local agent"
                        IsActive="False"
                        VerticalAlignment="Top"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="HomeStatusIcon"
                        Width="24"
                        AutomationProperties.Name="Manager status"
                        FontSize="20"
                        Glyph="&#xE946;"
                        VerticalAlignment="Top" />
                    <StackPanel
                        Grid.Column="1"
                        Spacing="5">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            x:Uid="HomeStatusSectionTitle"
                            Style="{StaticResource PastralSectionHeaderStyle}"
                            Text="Capture status" />
                        <TextBlock
                            x:Name="HomeStatusTitle"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Loading local status" />
                        <TextBlock
                            x:Name="HomeStatusDetail"
                            MaxWidth="760"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Checking the presentation provider." />
                    </StackPanel>
                    <Button
                        x:Name="RetryConnectionButton"
                        Grid.Column="2"
                        AutomationProperties.Name="Refresh local agent connection"
                        Click="RetryConnection_Click"
                        Content="Refresh"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border
                x:Name="HomeOverviewRegion"
                Grid.Row="3"
                AutomationProperties.Name="System overview"
                Style="{StaticResource PastralCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            x:Uid="HomeOverviewTitle"
                            Style="{StaticResource PastralSectionHeaderStyle}"
                            Text="Privacy and storage" />
                        <TextBlock
                            x:Uid="HomeOverviewSubtitle"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Verified local state, profile protection, and storage boundaries." />
                    </StackPanel>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            AutomationProperties.Name="Capture state"
                            FontSize="18"
                            Glyph="&#xE7C8;"
                            VerticalAlignment="Top" />
                        <StackPanel
                            Grid.Column="1"
                            Spacing="3">
                            <TextBlock
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Capture state" />
                            <TextBlock
                                x:Name="HomeCaptureValue"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Unavailable"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="The manager shows only state supplied through its provider boundary." />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        IsHitTestVisible="False" />

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            AutomationProperties.Name="Active profile"
                            FontSize="18"
                            Glyph="&#xE77B;"
                            VerticalAlignment="Top" />
                        <StackPanel
                            Grid.Column="1"
                            Spacing="3">
                            <TextBlock
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Active profile" />
                            <TextBlock
                                x:Name="HomeProfileValue"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Ordinary"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Private remains unavailable until encryption, lock, and recovery gates pass." />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        IsHitTestVisible="False" />

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            AutomationProperties.Name="Local data"
                            FontSize="18"
                            Glyph="&#xEDA2;"
                            VerticalAlignment="Top" />
                        <StackPanel
                            Grid.Column="1"
                            Spacing="3">
                            <TextBlock
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Local data" />
                            <TextBlock
                                x:Name="HomeStorageValue"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Unavailable"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="The manager never opens SQLite or blob storage directly." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid
                Grid.Row="4"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            x:Uid="HomeRecentTitle"
                            Style="{StaticResource PastralSectionHeaderStyle}"
                            Text="Recent activity" />
                        <TextBlock
                            x:Uid="HomeRecentSubtitle"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Privacy-safe previews from the verified local agent." />
                    </StackPanel>
                    <TextBlock
                        x:Name="HomeRecentCount"
                        Grid.Column="1"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PastralMetadataTextStyle}"
                        Text="0 items"
                        VerticalAlignment="Bottom" />
                </Grid>

                <ListView
                    x:Name="HomeRecentClipsList"
                    Grid.Row="1"
                    AutomationProperties.Name="Recent clips"
                    IsItemClickEnabled="False"
                    MaxHeight="420"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                AutomationProperties.Name="{Binding AutomationName}"
                                Padding="12,10"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{Binding SafePreview}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource PastralMetadataTextStyle}"
                                        Text="{Binding Source}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Spacing="3">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{Binding TypeLabel}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource PastralMetadataTextStyle}"
                                        Text="{Binding RelativeTime}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        MaxWidth="240"
                                        Style="{StaticResource PastralMetadataTextStyle}"
                                        Text="{Binding RepresentationSummary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    x:Name="HomeEmptyStatePanel"
                    Grid.Row="1"
                    AutomationProperties.Name="Recent clips empty state"
                    Style="{StaticResource PastralCardStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="48"
                            Height="48"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <FontIcon
                                AutomationProperties.Name="History"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Glyph="&#xE81C;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                x:Name="HomeEmptyStateTitle"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="No recent clips are available" />
                            <TextBlock
                                x:Name="HomeEmptyStateDetail"
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Connect the local agent to receive privacy-safe history. Release builds never invent sample data." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
