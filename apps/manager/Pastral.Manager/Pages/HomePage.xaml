<Page
    x:Class="Pastral.Manager.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer
        AutomationProperties.Name="Home page content"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="{StaticResource PastralContentMaxWidth}"
            Padding="24,20,24,32"
            RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock
                    x:Uid="HomePageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PastralPageHeaderStyle}"
                    Text="Home" />
                <TextBlock
                    x:Uid="HomePageSubtitle"
                    MaxWidth="720"
                    HorizontalAlignment="Left"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="A calm operational overview of capture, privacy, and local history." />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Spacing="12">
                <InfoBar
                    x:Name="HomeConnectionStatus"
                    AutomationProperties.Name="Manager connection status"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />
                <InfoBar
                    x:Name="HomeSyntheticNotice"
                    AutomationProperties.Name="Synthetic preview disclosure"
                    IsClosable="False"
                    IsOpen="True"
                    Message="These six bounded examples exist only in Debug builds and are not clipboard history."
                    Severity="Informational"
                    Title="Synthetic preview data"
                    Visibility="Collapsed" />
            </StackPanel>

            <Border
                x:Name="HomeOperationalStateRegion"
                Grid.Row="2"
                AutomationProperties.Name="Operational state"
                Style="{StaticResource PastralCardStyle}">
                <Grid
                    ColumnSpacing="20"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Manager status" />
                        <TextBlock
                            x:Name="HomeStatusTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Loading local status" />
                        <TextBlock
                            x:Name="HomeStatusDetail"
                            MaxWidth="760"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Checking the presentation provider." />
                    </StackPanel>
                    <Button
                        x:Name="RetryConnectionButton"
                        Grid.Column="1"
                        AutomationProperties.Name="Retry local agent connection"
                        Click="RetryConnection_Click"
                        Content="Retry"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ItemsControl
                Grid.Row="3"
                AutomationProperties.Name="Manager summary">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemWidth="328"
                            MaximumRowsOrColumns="3"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Border
                    Margin="0,0,16,16"
                    AutomationProperties.Name="Capture state"
                    Style="{StaticResource PastralCardStyle}">
                    <StackPanel Spacing="10">
                        <FontIcon
                            AutomationProperties.Name="Capture state"
                            FontSize="20"
                            Glyph="&#xE7C8;" />
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Capture state" />
                        <TextBlock
                            x:Name="HomeCaptureValue"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Unavailable" />
                        <TextBlock
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="The manager shows only state supplied through its provider boundary." />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,0,16,16"
                    AutomationProperties.Name="Active profile"
                    Style="{StaticResource PastralCardStyle}">
                    <StackPanel Spacing="10">
                        <FontIcon
                            AutomationProperties.Name="Profile"
                            FontSize="20"
                            Glyph="&#xE77B;" />
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Profile" />
                        <TextBlock
                            x:Name="HomeProfileValue"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Ordinary" />
                        <TextBlock
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Private remains unavailable until encryption, lock, and recovery gates pass." />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,0,0,16"
                    AutomationProperties.Name="Local storage summary"
                    Style="{StaticResource PastralCardStyle}">
                    <StackPanel Spacing="10">
                        <FontIcon
                            AutomationProperties.Name="Local data"
                            FontSize="20"
                            Glyph="&#xEDA2;" />
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Local data" />
                        <TextBlock
                            x:Name="HomeStorageValue"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Unavailable" />
                        <TextBlock
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="The manager never opens SQLite or blob storage directly." />
                    </StackPanel>
                </Border>
            </ItemsControl>

            <Grid
                Grid.Row="4"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Recent clips" />
                        <TextBlock
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Privacy-safe preview metadata supplied by the active provider." />
                    </StackPanel>
                    <TextBlock
                        x:Name="HomeRecentCount"
                        Grid.Column="1"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PastralMetadataTextStyle}"
                        Text="0 items"
                        VerticalAlignment="Bottom" />
                </Grid>

                <ListView
                    x:Name="HomeRecentClipsList"
                    Grid.Row="1"
                    AutomationProperties.Name="Recent clips"
                    IsItemClickEnabled="False"
                    MaxHeight="420"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                AutomationProperties.Name="{Binding AutomationName}"
                                Padding="12,10"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{Binding SafePreview}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <TextBlock
                                            Style="{StaticResource PastralMetadataTextStyle}"
                                            Text="{Binding Source}" />
                                        <TextBlock
                                            Style="{StaticResource PastralMetadataTextStyle}"
                                            Text="·" />
                                        <TextBlock
                                            Style="{StaticResource PastralMetadataTextStyle}"
                                            Text="{Binding RelativeTime}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{Binding TypeLabel}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource PastralMetadataTextStyle}"
                                        Text="{Binding RepresentationSummary}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource PastralMetadataTextStyle}"
                                        Text="{Binding Profile}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    x:Name="HomeEmptyStatePanel"
                    Grid.Row="1"
                    AutomationProperties.Name="Recent clips empty state"
                    Style="{StaticResource PastralCardStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="48"
                            Height="48"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <FontIcon
                                AutomationProperties.Name="History"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Glyph="&#xE81C;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="No recent clips are available" />
                            <TextBlock
                                Style="{StaticResource PastralMetadataTextStyle}"
                                Text="Connect the local agent to receive privacy-safe history. Release builds never invent sample data." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
