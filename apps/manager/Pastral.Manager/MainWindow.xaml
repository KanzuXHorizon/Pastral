<Window
    x:Class="Pastral.Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pastral">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            AutomationProperties.Name="Pastral manager title bar"
            Subtitle="Private local clipboard intelligence"
            Title="Pastral" />

        <NavigationView
            x:Name="ShellNavigationView"
            Grid.Row="1"
            x:Uid="ShellNavigationView"
            AutomationProperties.Name="Pastral manager navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            SelectionChanged="ShellNavigationView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavigationItem"
                    x:Uid="HomeNavigationItem"
                    Content="Home"
                    Icon="Home"
                    Tag="home" />
                <NavigationViewItem
                    x:Name="HistoryNavigationItem"
                    x:Uid="HistoryNavigationItem"
                    Content="History"
                    Icon="Library"
                    Tag="history" />
            </NavigationView.MenuItems>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="GlobalStatusBar"
                    Margin="16,12,16,0"
                    AutomationProperties.Name="Global manager operational status"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational"
                    Title="Manager foundation"
                    Message="The native manager is running. Live clipboard history remains disconnected until local IPC is implemented." />

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    AutomationProperties.Name="Manager page content"
                    IsNavigationStackEnabled="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
