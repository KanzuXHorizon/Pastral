<Window
    x:Class="Pastral.Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pastral">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            AutomationProperties.Name="Pastral manager title bar"
            Subtitle="Private local clipboard memory"
            Title="Pastral" />

        <NavigationView
            x:Name="ShellNavigationView"
            Grid.Row="1"
            x:Uid="ShellNavigationView"
            AutomationProperties.Name="Pastral manager navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            SelectionChanged="ShellNavigationView_SelectionChanged">

            <NavigationView.PaneHeader>
                <Grid
                    Margin="0,8,0,12"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        AutomationProperties.Name="Pastral signal trail logo"
                        Style="{StaticResource PastralBrandMarkStyle}">
                        <Grid>
                            <Border
                                Width="14"
                                Height="18"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="4" />
                            <Border
                                Width="12"
                                Height="12"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                BorderBrush="#CCFFFFFF"
                                BorderThickness="2"
                                CornerRadius="4" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            x:Uid="BrandName"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Pastral" />
                        <TextBlock
                            x:Uid="BrandPositioning"
                            Style="{StaticResource PastralMetadataTextStyle}"
                            Text="Local clipboard memory" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavigationItem"
                    x:Uid="HomeNavigationItem"
                    Content="Home"
                    Icon="Home"
                    Tag="home" />
                <NavigationViewItem
                    x:Name="HistoryNavigationItem"
                    x:Uid="HistoryNavigationItem"
                    Content="History"
                    Icon="Library"
                    Tag="history" />
            </NavigationView.MenuItems>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="GlobalStatusBar"
                    Margin="16,12,16,0"
                    AutomationProperties.Name="Global manager operational status"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    Title="Manager status"
                    Visibility="Collapsed" />

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    AutomationProperties.Name="Manager page content"
                    IsNavigationStackEnabled="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
